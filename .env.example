# Copia este archivo como .env para configuracion local. No pongas secretos aqui.
# MLflow: por defecto sqlite:///<repo>/mlflow.db. Para entrenar en paralelo, un servidor:
# MLFLOW_TRACKING_URI=http://127.0.0.1:5055
# MLflow remoto con UI publica (DagsHub); las credenciales van en .env local, nunca en Git:
# MLFLOW_TRACKING_URI=https://dagshub.com/tomas-gonzalez2006/robot_expedition.mlflow
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# API: origenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://web-five-gules-83.vercel.app
# API: ZIP publico de modelos de la release (se extrae solo models/<run_id>/ y se verifica el SHA-256)
API_MODELS_URL=https://github.com/nataliariosmoreno11-dev/robot_expedition/releases/download/models-v2/robot-expedition-models-v2.zip
# API: 1 = intentar tambien `dvc pull` si faltan los pesos
API_DVC_PULL=0
# Credenciales del remoto DVC (solo en el servidor o como secretos del Space)
DVC_REMOTE_USER=
DVC_REMOTE_PASSWORD=

# Pipeline: URL de la API desplegada para la etapa 8 (version servida) y autor de las publicaciones
API_URL=
CATALOG_ACTOR=
# Semillas del test final reservado (no se suben a Git): "123,456,..."
EXPEDITION_TEST_SEEDS=
